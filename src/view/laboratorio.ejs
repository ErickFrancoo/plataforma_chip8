<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Laboratório CHIP-8</title>
    <link rel="stylesheet" href="/laboratorio/estilo.css">
</head>
<body>
    <header>
        <h1>Laboratório CHIP-8</h1>
        <p>Escreva um programa em hexadecimal ou abra um arquivo .ch8 e veja a CPU funcionando.</p>
    </header>

    <main>
        <section class="maquina">
            <canvas id="tela" width="640" height="320"></canvas>

            <div class="controles">
                <button id="botao-executar" disabled>Executar</button>
                <button id="botao-pausar" disabled>Pausar</button>
                <button id="botao-passo" disabled>Próxima instrução</button>
                <button id="botao-reiniciar" disabled>Reiniciar</button>
            </div>

            <div class="controles">
                <label>Velocidade
                    <select id="velocidade">
                        <option value="1">muito lenta (60 instruções/s)</option>
                        <option value="10" selected>normal (600 instruções/s)</option>
                        <option value="50">rápida (3.000 instruções/s)</option>
                        <option value="100">muito rápida (6.000 instruções/s)</option>
                    </select>
                </label>
                <label>Perfil
                    <select id="perfil">
                        <option value="original" selected>CHIP-8 original</option>
                        <option value="moderno">SUPER-CHIP (jogos mais novos)</option>
                    </select>
                </label>
            </div>

            <p id="situacao" class="situacao">Carregando o núcleo...</p>

            <p class="ajuda">
                Teclado do CHIP-8: <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><kbd>4</kbd>
                <kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd>
                <kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><kbd>F</kbd>
                <kbd>Z</kbd><kbd>X</kbd><kbd>C</kbd><kbd>V</kbd>
            </p>
        </section>

        <section class="estado">
            <h2>Estado da máquina</h2>
            <div class="registradores">
                <% const nomes = ['V0', 'V1', 'V2', 'V3', 'V4', 'V5', 'V6', 'V7',
                                  'V8', 'V9', 'VA', 'VB', 'VC', 'VD', 'VE', 'VF',
                                  'I', 'PC', 'SP', 'DT', 'ST']; %>
                <% for (const nome of nomes) { %>
                    <div class="registrador">
                        <span><%= nome %></span>
                        <strong id="reg-<%= nome %>">00</strong>
                    </div>
                <% } %>
            </div>
            <p class="legenda">DT: timer de atraso · ST: timer de som · em verde, o que mudou na última instrução</p>

            <h2>Próxima instrução</h2>
            <p id="instrucao" class="instrucao">--</p>
        </section>

        <section class="programa">
            <h2>Programa</h2>
            <div class="controles">
                <label>Exemplo <select id="exemplos"></select></label>
                <label>Abrir arquivo .ch8 <input type="file" id="arquivo" accept=".ch8"></label>
            </div>
            <textarea id="editor" spellcheck="false"></textarea>
            <ul id="erros" class="erros"></ul>
        </section>
    </main>

    <!-- A ordem importa: o núcleo e os arquivos compartilhados vêm antes do laboratório -->
    <script src="/nucleo/chip8.js"></script>
    <script src="/compartilhado/hex.js"></script>
    <script src="/compartilhado/perfil.js"></script>
    <script src="/laboratorio/exemplos.js"></script>
    <script src="/laboratorio/tela.js"></script>
    <script src="/laboratorio/teclado.js"></script>
    <script src="/laboratorio/som.js"></script>
    <script src="/laboratorio/painel.js"></script>
    <script src="/laboratorio/laboratorio.js"></script>
</body>
</html>
