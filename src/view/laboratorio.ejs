<%# O laboratório. Sem desafio, é o laboratório livre; com desafio, mostra o enunciado e o botão de submeter. %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= desafio ? desafio.titulo + ' · ' : '' %>Laboratório CHIP-8</title>
    <link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/laboratorio/estilo.css">
</head>
<body class="editando" data-desafio="<%= desafio ? desafio.id : '' %>">
    <%# Na página do desafio não há escolha de perfil: vale o original, o mesmo do verificador %>
    <%- include('parciais/topo', { pagina: desafio ? 'desafios' : 'laboratorio', comPerfil: !desafio }) %>

    <main class="laboratorio">
        <section class="cartao maquina">
            <div class="moldura">
                <canvas id="tela" width="640" height="320"></canvas>
            </div>

            <div class="controles">
                <button id="botao-executar" class="principal" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    Executar
                </button>
                <button id="botao-pausar" class="icone" disabled title="Pausar" aria-label="Pausar">
                    <svg class="icone-pausar" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
                    <svg class="icone-continuar" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </button>
                <button id="botao-passo" class="icone" disabled title="Próxima instrução" aria-label="Próxima instrução">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14l9-7zM16 5h3v14h-3z"/></svg>
                </button>
                <button id="botao-reiniciar" class="icone" disabled title="Reiniciar" aria-label="Reiniciar">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                </button>
                <div class="velocidade">
                    <input type="range" id="velocidade" min="0" max="5" value="2" aria-label="Velocidade">
                    <span id="velocidade-texto"></span>
                </div>
            </div>

            <p id="situacao" class="situacao">Carregando o núcleo...</p>

            <div class="registradores">
                <% const nomes = ['V0', 'V1', 'V2', 'V3', 'V4', 'V5', 'V6', 'V7',
                                  'V8', 'V9', 'VA', 'VB', 'VC', 'VD', 'VE', 'VF',
                                  'I', 'PC', 'SP', 'DT', 'ST']; %>
                <% for (const nome of nomes) { %>
                    <div class="registrador">
                        <span><%= nome %></span>
                        <strong id="reg-<%= nome %>">00</strong>
                    </div>
                <% } %>
            </div>
            <p class="legenda">DT: timer de atraso · ST: timer de som · em laranja, o que mudou na última instrução</p>

            <p class="ajuda">
                Teclado do CHIP-8: <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><kbd>4</kbd>
                <kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd>
                <kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><kbd>F</kbd>
                <kbd>Z</kbd><kbd>X</kbd><kbd>C</kbd><kbd>V</kbd>
            </p>
        </section>

        <section class="cartao programa">
            <% if (desafio) { %>
                <p class="trilha"><a href="/desafios">Desafios</a> › <%= desafio.titulo %></p>
                <div class="enunciado">
                    <span class="rotulo">DESAFIO</span>
                    <h2><%= desafio.titulo %></h2>
                    <p><%= desafio.enunciado %></p>
                    <div class="para-passar">
                        <span class="rotulo">PARA PASSAR</span>
                        <% for (const condicao of desafio.condicoes) { %>
                            <div><%= condicao.descricao() %></div>
                        <% } %>
                        <div class="detalhe">O programa precisa terminar em até <%= desafio.limiteDeInstrucoes %> instruções.</div>
                    </div>
                </div>
            <% } else { %>
                <div id="exemplos" class="chips"></div>
            <% } %>

            <%# A coluna à esquerda mostra o endereço de cada linha; o laboratorio.js a preenche e a rola junto com o editor %>
            <div class="editor-com-enderecos">
                <div class="enderecos-editor" id="enderecosEditor">
                    <div id="enderecosContent"></div>
                </div>
                <textarea id="editor" spellcheck="false"></textarea>
            </div>

            <div id="listagem" class="listagem">
                <div id="destaque" class="destaque oculto"></div>
            </div>

            <div id="agora" class="agora">
                <span class="rotulo">PRÓXIMA INSTRUÇÃO</span>
                <p class="agora-instrucao"></p>
                <p class="agora-comentario"></p>
            </div>

            <ul id="erros" class="erros"></ul>

            <div class="acoes">
                <button id="botao-editar" class="chip" type="button">Editar</button>
                <label class="chip">Abrir .ch8
                    <input type="file" id="arquivo" accept=".ch8" hidden>
                </label>
                <%# Arquivos de texto com o programa escrito; os .ch8 (bytes) usam o "Abrir .ch8" %>
                <label class="chip">Importar texto
                    <input type="file" id="arquivo-texto" accept=".txt,.hex,text/plain" hidden>
                </label>
                <% if (desafio) { %>
                    <%# O formulário envia só o texto do programa; o servidor executa e decide %>
                    <form id="form-submeter" method="post" action="/desafios/<%= desafio.id %>/submeter">
                        <input type="hidden" name="programa" id="programa-enviado">
                        <button type="submit" class="principal">Submeter solução</button>
                    </form>
                <% } %>
                <%# Os links de ajuda abrem numa aba nova, para o aluno não perder o que escreveu no editor %>
                <a href="/aprender/as-instrucoes" class="chip" target="_blank">Instruções</a>
                <a href="/aprender/timers-e-teclado" class="chip" target="_blank">Timers e Teclado</a>
            </div>
        </section>
    </main>

    <!-- A ordem importa: o núcleo e os arquivos compartilhados vêm antes do laboratório -->
    <script src="/nucleo/chip8.js"></script>
    <script src="/compartilhado/hex.js"></script>
    <script src="/compartilhado/perfil.js"></script>
    <script src="/laboratorio/exemplos.js"></script>
    <script src="/laboratorio/tela.js"></script>
    <script src="/laboratorio/teclado.js"></script>
    <script src="/laboratorio/som.js"></script>
    <script src="/laboratorio/painel.js"></script>
    <script src="/laboratorio/listagem.js"></script>
    <script src="/laboratorio/laboratorio.js"></script>
</body>
</html>
