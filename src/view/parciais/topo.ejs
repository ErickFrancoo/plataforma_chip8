<%# Topo de todas as páginas. Recebe: pagina ('laboratorio', 'aprender', 'desafios', 'gerenciar' ou 'entrar')
    e comPerfil (true ou false). "usuario" (quem está logado, ou null) e "ehInstrutor" vêm do servidor. %>
<header class="topo">
    <div class="marca">
        <span class="logo"></span>
        <h1>CHIP-8 LAB</h1>
    </div>
    <nav class="menu">
        <a href="/" class="<%= pagina === 'laboratorio' ? 'ativo' : '' %>">Laboratório</a>
        <a href="/aprender" class="<%= pagina === 'aprender' ? 'ativo' : '' %>">Aprender</a>
        <a href="/desafios" class="<%= pagina === 'desafios' ? 'ativo' : '' %>">Desafios</a>
        <% if (ehInstrutor) { %>
            <a href="/instrutor/desafios" class="<%= pagina === 'gerenciar' ? 'ativo' : '' %>">Gerenciar desafios</a>
        <% } %>
    </nav>
    <div class="lado-direito">
        <% if (comPerfil) { %>
            <label class="perfil">Perfil
                <select id="perfil">
                    <option value="original" selected>CHIP-8 original</option>
                    <option value="moderno">SUPER-CHIP (jogos mais novos)</option>
                </select>
            </label>
        <% } %>
        <% if (usuario) { %>
            <span class="usuario-logado"><%= usuario.nome %></span>
            <form method="post" action="/sair">
                <button class="chip" type="submit">Sair</button>
            </form>
        <% } else if (pagina !== 'entrar') { %>
            <a class="chip" href="/entrar">Entrar</a>
        <% } %>
    </div>
</header>
